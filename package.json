{
  "name": "where-i-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "pod:dev": "npx --yes @solid/community-server@7.2.0 -p 3001 -c @css:config/file.json -f ./.pod-data",
    "size": "size-limit"
  },
  "dependencies": {
    "@inrupt/solid-client": "3.0.0",
    "@inrupt/solid-client-authn-browser": "5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exifreader": "4.44.0",
    "lucide-react": "^1.39.0",
    "maplibre-gl": "6.6.0",
    "n3": "2.7.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "8.1.2",
    "shadcn": "^4.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@size-limit/preset-app": "13.0.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/n3": "1.26.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.22.2"
  },
  "size-limit": [
    {
      "name": "public routes \u2014 first-load JS",
      "path": [
        ".next/static/chunks/**/*.js"
      ],
      "limit": "200 kB",
      "gzip": true
    }
  ]
}
